# rlark-upgrade: minimal image for cluster upgrade Jobs.
#
# The upgrade Pod runs this image and performs a fully autonomous upgrade:
# precheck (via rlarkadm), upgrade (via rlarkadm), deep health check, and
# automatic rollback on failure. kubectl is bundled for KCP-related
# operations (extracting admin.kubeconfig, installing CRDs).
#
# Build:
#   docker buildx build \
#     --platform linux/amd64 \
#     --push \
#     -t <registry>/rlark-upgrade:v0.0.1 \
#     -f Dockerfile.upgrade \
#     ../..

ARG GO_BASE_IMAGE=golang:1.26-alpine
ARG RUNTIME_BASE_IMAGE=ubuntu:22.04

# -- Build stage -------------------------------------------------------------
FROM ${GO_BASE_IMAGE} AS builder

WORKDIR /src
COPY api/go.mod api/go.sum ./api/
COPY sdks/execution-go/go.mod sdks/execution-go/go.sum ./sdks/execution-go/
COPY apps/rlark/go.mod apps/rlark/go.sum ./apps/rlark/
RUN --mount=type=cache,target=/go/pkg/mod \
    GOMODCACHE=/go/pkg/mod go mod download -C apps/rlark

COPY api/ ./api/
COPY sdks/execution-go/ ./sdks/execution-go/
COPY apps/rlark/ ./apps/rlark/

RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    GOMODCACHE=/go/pkg/mod GOCACHE=/root/.cache/go-build \
    cd apps/rlark && \
    CGO_ENABLED=0 GOOS=linux go build -o /rlark-upgrade ./cmd/rlark-upgrade

# -- Runtime stage -----------------------------------------------------------
FROM ${RUNTIME_BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*

# Install kubectl (pinned to the version used by the KCP post-install hook)
ARG KUBECTL_VERSION=1.33.1
RUN curl -fsSL -o /usr/local/bin/kubectl \
      "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
    && chmod +x /usr/local/bin/kubectl

COPY --from=builder /rlark-upgrade /usr/local/bin/rlark-upgrade

ENTRYPOINT ["/usr/local/bin/rlark-upgrade"]
